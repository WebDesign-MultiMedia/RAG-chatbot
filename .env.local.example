# Copy to .env.local and fill in real values. Never commit .env.local.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: defaults shown
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DataStax AstraDB (vector database, dimension 1536)
ASTRA_DB_API_ENDPOINT=https://your-database-id-your-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your-application-token
ASTRA_DB_NAMESPACE=default_keyspace
ASTRA_DB_COLLECTION=nyc_gpt
